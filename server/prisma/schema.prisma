generator client {
  provider = "prisma-client-js"
}

// Local dev runs on SQLite. To go live on Postgres (e.g. Supabase):
// change provider to "postgresql", point DATABASE_URL in server/.env at the
// connection string, and run `npx prisma db push`. Nothing else changes —
// mutuals, badges, trending etc. are all computed from these tables.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth is phone-first (SMS code). Email/password remains only for legacy
// dev accounts and disappears with the Supabase Auth migration.
model User {
  id                 String    @id @default(cuid())
  name               String    @default("")
  // Public, unique handle used for search, invites and mentions.
  username           String?   @unique
  email              String?   @unique
  passwordHash       String?
  phone              String?   @unique
  phoneCode          String?
  phoneCodeExpiresAt DateTime?
  avatarEmoji        String    @default("🙂")
  // Path to an uploaded profile photo (from POST /api/uploads), '' = emoji only.
  avatarImage        String    @default("")
  // Short free-text self-description shown on the profile ("about me").
  bio                String    @default("")
  city               String    @default("San Francisco")
  // Curator / venue / promoter accounts (e.g. "YE Munich"). They host events
  // but are not real people, so they never count as a "mutual" friend.
  isOrganization     Boolean   @default(false)
  // Product admins can review public-event submissions and, in preview builds,
  // inspect private events. Never inferred from a client request.
  isAdmin            Boolean   @default(false)
  createdAt      DateTime       @default(now())
  events         Event[]        @relation("HostEvents")
  rsvps          Rsvp[]
  comments       Comment[]
  cohosting      EventCohost[]
  cohostInvitesSent CohostInvite[] @relation("CohostInvitesSent")
  crushesSent    Crush[]        @relation("CrushesSent")
  crushesGotten  Crush[]        @relation("CrushesGotten")
  plusOneAppearances PlusOne[]  @relation("PlusOneGuest")
  partyMemories   PartyConnection[] @relation("MyPartyMemories")
  partyMemoriesOf PartyConnection[] @relation("PartyMemoryOf")
  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")
  eventInvitesReceived EventInvite[] @relation("EventInvitesReceived")
  eventInvitesSent     EventInvite[] @relation("EventInvitesSent")
  eventApplications    EventApplication[]
}

// Records who uploaded each file (path = "/uploads/x.jpg") so a user can only
// reference their own uploads — e.g. setting a profile photo. Without this, any
// authed user could point their avatar at another user's file and get it deleted
// by the reclaim logic.
model Upload {
  path      String   @id
  userId    String
  createdAt DateTime @default(now())
}

// A durable "we partied together" link between two users, snapshotted the
// moment an event is hard-deleted so the mutuals it created survive the cascade
// that wipes its RSVPs. Directed (userId → otherUser) so each person's list
// stands on its own. eventTitle snapshots the most recent shared party; there's
// no slug because the event row is gone. Mutuals from LIVE events are still
// computed on the fly — these rows only fill in the parties that no longer exist.
model PartyConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("MyPartyMemories", fields: [userId], references: [id], onDelete: Cascade)
  otherUserId String
  otherUser   User     @relation("PartyMemoryOf", fields: [otherUserId], references: [id], onDelete: Cascade)
  eventTitle  String   @default("")
  // The deleted event's date — the tie-breaker for "most recent shared party".
  sharedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, otherUserId])
  @@index([userId])
}

// A friend request and — once accepted — the friendship itself. One row per
// pair, directed from the requester: status PENDING | ACCEPTED | DECLINED
// (SQLite has no enums, mirroring CohostInvite). A declined request can be
// re-sent, which flips the same row back to PENDING; unfriending deletes the
// row. Distinct from computed "mutuals" (co-attendance): friends are an
// explicit, chosen graph.
model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("FriendshipsSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("FriendshipsReceived", fields: [toId], references: [id], onDelete: Cascade)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromId, toId])
  @@index([toId])
}

// One-way crush; when reciprocal, both get notified.
model Crush {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("CrushesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("CrushesGotten", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// titleFont: classic | literary | fancy | eclectic
// effect: none | confetti | sparkles | balloons
// category: music | community | arts | food | sports | other
model Event {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String        @default("")
  // Body font-size for the description, as a percent of the base size (100 = default).
  descriptionScale Int        @default(100)
  coverTheme    String        @default("sunset")
  coverImage    String        @default("")
  // External ticket/checkout URL for scraped events. The buy-ticket button
  // opens this (the organiser's real paid-ticket page — Eventbrite/RA/venue,
  // never a free-signup lu.ma link). '' for regular user-created events.
  ticketUrl     String        @default("")
  titleFont     String        @default("classic")
  effect        String        @default("none")
  date          DateTime
  location      String        @default("")
  city          String        @default("")
  category      String        @default("community")
  isPublic      Boolean       @default(false)
  // PRIVATE | PENDING | APPROVED | REJECTED. `isPublic` stays the fast
  // discovery flag and is true only after an admin approves the submission.
  publicationStatus String    @default("PRIVATE")
  // Hosts may keep a real venue private until a guest is confirmed GOING.
  hideLocation  Boolean       @default(false)
  costPerPerson String        @default("")
  dressCode     String        @default("")
  // Short free-text mood ("Cozy living-room energy, bring your softest sweater").
  vibe          String        @default("")
  // Optional end of the event. openEnd marks an explicit "goes until it's
  // over"; both unset means the host simply didn't say.
  endDate       DateTime?
  openEnd       Boolean       @default(false)
  // How strictly guests should arrive on time: '' | sharp | grace | loose.
  punctuality   String        @default("")
  maxGuests     Int?
  plusOneLimit  Int           @default(1)
  rsvpsOpen     Boolean       @default(true)
  // Guests must apply (and be approved by a host) before they can be GOING.
  applicationRequired Boolean @default(false)
  // JSON array of up to 3 host-defined questions applicants must answer.
  applicationQuestions String @default("[]")
  canceledAt    DateTime?
  hostId        String
  host          User          @relation("HostEvents", fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  rsvps         Rsvp[]
  comments      Comment[]
  cohosts       EventCohost[]
  cohostInvites CohostInvite[]
  invites       EventInvite[]
  applications  EventApplication[]
}

// A guest's request to join an application-gated event. One row per
// (event, user); a re-apply after a decline flips the same row back to
// PENDING (mirroring CohostInvite). Approval creates the GOING rsvp.
// status: PENDING | APPROVED | DECLINED (SQLite has no enums).
model EventApplication {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON array of { question, answer } pairs, questions snapshotted at
  // apply time so later edits don't orphan existing answers.
  answers   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status])
}

// A direct in-app invite from a host to a friend/mutual. The invite itself
// does not consume capacity; the recipient still chooses an RSVP on the event.
model EventInvite {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("EventInvitesReceived", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User     @relation("EventInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

// A pending co-host invitation, addressed to a phone number (the invitee may
// not have an account yet). The host invites by phone; the recipient signs in
// via the normal phone-verification flow and then must ACCEPT — only on accept
// do we create the EventCohost (+ GOING rsvp). status: PENDING | ACCEPTED |
// DECLINED (SQLite has no enums, so it's a String, mirroring Rsvp.status).
// Unique per (event, phone) so a number can't hold two open invites; a
// re-invite after a decline just flips the same row back to PENDING.
model CohostInvite {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Normalized (E.164) phone the invite was sent to — matched against the
  // invitee's account phone once they sign in.
  phone       String
  invitedById String
  invitedBy   User     @relation("CohostInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, phone])
  @@index([phone])
}

model EventCohost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// status: GOING | MAYBE | CANT | WAITLIST (SQLite has no enums)
// waitlistedAt records when the guest entered the waitlist — the FIFO key.
// createdAt can't serve that role: it's frozen at the user's first RSVP of any status.
model Rsvp {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String
  // Denormalized count of plusOneGuests, kept in sync on every write so the
  // capacity/waitlist/count math (countRsvps, promoteWaitlist) stays cheap.
  plusOnes     Int       @default(0)
  waitlistedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plusOneGuests PlusOne[]

  @@unique([eventId, userId])
}

// A named guest an attendee brings along ("+1"). Attached to the host's Rsvp;
// counts as one extra head via Rsvp.plusOnes. userId links it to an iykyk user
// when the +1 was picked from mutuals; a manually-added +1 stores name + phone
// only (no account, no login). An attendee may bring several (up to
// min(plusOneLimit, MAX_PLUS_ONES)); the cap is enforced in the route layer.
model PlusOne {
  id        String   @id @default(cuid())
  rsvpId    String
  rsvp      Rsvp     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  userId    String?
  user      User?    @relation("PlusOneGuest", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([rsvpId])
}

// An agentic ticket-purchase job: the server-side agent visits the event's
// checkout page (demo provider or the real ticket URL) and buys a ticket with
// the user's Agent Wallet. Card data is NEVER stored — it lives only in the
// job runner's memory while the job executes; this row keeps just the masked
// tail (cardLast4) for display. Like Upload, plain IDs instead of relations so
// the existing models stay untouched.
// status: checking | available | soldout | purchasing | done | failed
//   (SQLite has no enums). A job is created in "checking" (availability), moves
//   to "available"/"soldout", then on payment to "purchasing" and done/failed.
// provider: demo (server-hosted test checkout) | web (the event's real ticket URL)
model TicketJob {
  id         String   @id @default(cuid())
  userId     String
  eventId    String
  status     String   @default("checking")
  provider   String   @default("demo")
  // "/uploads/tickets/<uuid>.pdf" once the agent generated the ticket PDF.
  pdfPath    String   @default("")
  buyerName  String   @default("")
  cardLast4  String   @default("")
  // Human-readable failure reason ("bot protection", "no card field found"…).
  error      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([eventId, userId])
}

// type: "comment" (user-written) | "system" (activity entries like "X is going")
//     | "blast" (host announcement, also texted to guests)
model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  type      String   @default("comment")
  createdAt DateTime @default(now())
}
