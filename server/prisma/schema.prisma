generator client {
  provider = "prisma-client-js"
}

// Local dev runs on SQLite. To go live on Postgres (e.g. Supabase):
// change provider to "postgresql", point DATABASE_URL in server/.env at the
// connection string, and run `npx prisma db push`. Nothing else changes —
// mutuals, badges, trending etc. are all computed from these tables.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth is phone-first (SMS code). Email/password remains only for legacy
// dev accounts and disappears with the Supabase Auth migration.
model User {
  id                 String    @id @default(cuid())
  name               String    @default("")
  email              String?   @unique
  passwordHash       String?
  phone              String?   @unique
  phoneCode          String?
  phoneCodeExpiresAt DateTime?
  avatarEmoji        String    @default("🙂")
  // Path to an uploaded profile photo (from POST /api/uploads), '' = emoji only.
  avatarImage        String    @default("")
  city               String    @default("San Francisco")
  // Curator / venue / promoter accounts (e.g. "YE Munich"). They host events
  // but are not real people, so they never count as a "mutual" friend.
  isOrganization     Boolean   @default(false)
  createdAt      DateTime       @default(now())
  events         Event[]        @relation("HostEvents")
  rsvps          Rsvp[]
  comments       Comment[]
  cohosting      EventCohost[]
  crushesSent    Crush[]        @relation("CrushesSent")
  crushesGotten  Crush[]        @relation("CrushesGotten")
  plusOneAppearances PlusOne[]  @relation("PlusOneGuest")
  partyMemories   PartyConnection[] @relation("MyPartyMemories")
  partyMemoriesOf PartyConnection[] @relation("PartyMemoryOf")
}

// Records who uploaded each file (path = "/uploads/x.jpg") so a user can only
// reference their own uploads — e.g. setting a profile photo. Without this, any
// authed user could point their avatar at another user's file and get it deleted
// by the reclaim logic.
model Upload {
  path      String   @id
  userId    String
  createdAt DateTime @default(now())
}

// A durable "we partied together" link between two users, snapshotted the
// moment an event is hard-deleted so the mutuals it created survive the cascade
// that wipes its RSVPs. Directed (userId → otherUser) so each person's list
// stands on its own. eventTitle snapshots the most recent shared party; there's
// no slug because the event row is gone. Mutuals from LIVE events are still
// computed on the fly — these rows only fill in the parties that no longer exist.
model PartyConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("MyPartyMemories", fields: [userId], references: [id], onDelete: Cascade)
  otherUserId String
  otherUser   User     @relation("PartyMemoryOf", fields: [otherUserId], references: [id], onDelete: Cascade)
  eventTitle  String   @default("")
  // The deleted event's date — the tie-breaker for "most recent shared party".
  sharedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, otherUserId])
  @@index([userId])
}

// One-way crush; when reciprocal, both get notified.
model Crush {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("CrushesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("CrushesGotten", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// titleFont: classic | literary | fancy | eclectic
// effect: none | confetti | sparkles | balloons
// category: music | community | arts | food | sports | other
model Event {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String        @default("")
  // Body font-size for the description, as a percent of the base size (100 = default).
  descriptionScale Int        @default(100)
  coverTheme    String        @default("sunset")
  coverImage    String        @default("")
  titleFont     String        @default("classic")
  effect        String        @default("none")
  date          DateTime
  location      String        @default("")
  city          String        @default("")
  category      String        @default("community")
  isPublic      Boolean       @default(false)
  costPerPerson String        @default("")
  dressCode     String        @default("")
  maxGuests     Int?
  plusOneLimit  Int           @default(1)
  rsvpsOpen     Boolean       @default(true)
  canceledAt    DateTime?
  hostId        String
  host          User          @relation("HostEvents", fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  rsvps         Rsvp[]
  comments      Comment[]
  cohosts       EventCohost[]
}

model EventCohost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// status: GOING | MAYBE | CANT | WAITLIST (SQLite has no enums)
// waitlistedAt records when the guest entered the waitlist — the FIFO key.
// createdAt can't serve that role: it's frozen at the user's first RSVP of any status.
model Rsvp {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String
  // Denormalized count of plusOneGuests, kept in sync on every write so the
  // capacity/waitlist/count math (countRsvps, promoteWaitlist) stays cheap.
  plusOnes     Int       @default(0)
  waitlistedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plusOneGuests PlusOne[]

  @@unique([eventId, userId])
}

// A named guest an attendee brings along ("+1"). Attached to the host's Rsvp;
// counts as one extra head via Rsvp.plusOnes. userId links it to a Now user
// when the +1 was picked from mutuals; a manually-added +1 stores name + phone
// only (no account, no login). We cap it at one per Rsvp in the route layer.
model PlusOne {
  id        String   @id @default(cuid())
  rsvpId    String
  rsvp      Rsvp     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  userId    String?
  user      User?    @relation("PlusOneGuest", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  // One +1 per RSVP — enforced at the DB so a double-submit race can't create
  // two (the route also checks, but that check-then-act isn't atomic).
  @@unique([rsvpId])
}

// type: "comment" (user-written) | "system" (activity entries like "X is going")
//     | "blast" (host announcement, also texted to guests)
model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  type      String   @default("comment")
  createdAt DateTime @default(now())
}
