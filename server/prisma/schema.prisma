generator client {
  provider = "prisma-client-js"
}

// Local dev runs on SQLite. To go live on Postgres (e.g. Supabase):
// change provider to "postgresql", point DATABASE_URL in server/.env at the
// connection string, and run `npx prisma db push`. Nothing else changes —
// mutuals, badges, trending etc. are all computed from these tables.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth is phone-first (SMS code). Email/password remains only for legacy
// dev accounts and disappears with the Supabase Auth migration.
model User {
  id                 String    @id @default(cuid())
  name               String    @default("")
  email              String?   @unique
  passwordHash       String?
  phone              String?   @unique
  phoneCode          String?
  phoneCodeExpiresAt DateTime?
  avatarEmoji        String    @default("🙂")
  city               String    @default("San Francisco")
  createdAt      DateTime       @default(now())
  events         Event[]        @relation("HostEvents")
  rsvps          Rsvp[]
  comments       Comment[]
  cohosting      EventCohost[]
  notifications  Notification[]
  cardsSent      Card[]         @relation("CardsSent")
  cardsReceived  Card[]         @relation("CardsReceived")
  crushesSent    Crush[]        @relation("CrushesSent")
  crushesGotten  Crush[]        @relation("CrushesGotten")
  plusOneAppearances PlusOne[]  @relation("PlusOneGuest")
}

// A digital greeting card. `toId` is set when delivered in-app to a mutual;
// left null for cards shared by link (the card's id is its shareable handle).
model Card {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("CardsSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String?
  to        User?    @relation("CardsReceived", fields: [toId], references: [id], onDelete: Cascade)
  theme     String   @default("confetti")
  message   String
  createdAt DateTime @default(now())
}

// One-way crush; when reciprocal, both get notified.
model Crush {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("CrushesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("CrushesGotten", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// titleFont: classic | literary | fancy | eclectic
// effect: none | confetti | sparkles | balloons
// category: music | community | arts | food | sports | other
model Event {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String        @default("")
  coverTheme    String        @default("sunset")
  coverImage    String        @default("")
  titleFont     String        @default("classic")
  effect        String        @default("none")
  date          DateTime
  location      String        @default("")
  city          String        @default("")
  category      String        @default("community")
  isPublic      Boolean       @default(false)
  costPerPerson String        @default("")
  dressCode     String        @default("")
  maxGuests     Int?
  plusOneLimit  Int           @default(1)
  rsvpsOpen     Boolean       @default(true)
  canceledAt    DateTime?
  hostId        String
  host          User          @relation("HostEvents", fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  rsvps         Rsvp[]
  comments      Comment[]
  cohosts       EventCohost[]
}

model EventCohost {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

// type: RSVP | COMMENT | EVENT_UPDATED | EVENT_CANCELED | WAITLIST_PROMOTED | COHOST_ADDED
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  text      String
  eventSlug String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// status: GOING | MAYBE | CANT | WAITLIST (SQLite has no enums)
// waitlistedAt records when the guest entered the waitlist — the FIFO key.
// createdAt can't serve that role: it's frozen at the user's first RSVP of any status.
model Rsvp {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String
  // Denormalized count of plusOneGuests, kept in sync on every write so the
  // capacity/waitlist/count math (countRsvps, promoteWaitlist) stays cheap.
  plusOnes     Int       @default(0)
  waitlistedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  plusOneGuests PlusOne[]

  @@unique([eventId, userId])
}

// A named guest an attendee brings along ("+1"). Attached to the host's Rsvp;
// counts as one extra head via Rsvp.plusOnes. userId links it to a Hausi user
// when the +1 was picked from mutuals; a manually-added +1 stores name + phone
// only (no account, no login). We cap it at one per Rsvp in the route layer.
model PlusOne {
  id        String   @id @default(cuid())
  rsvpId    String
  rsvp      Rsvp     @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  userId    String?
  user      User?    @relation("PlusOneGuest", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  // One +1 per RSVP — enforced at the DB so a double-submit race can't create
  // two (the route also checks, but that check-then-act isn't atomic).
  @@unique([rsvpId])
}

// type: "comment" (user-written) | "system" (activity entries like "X is going")
model Comment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  type      String   @default("comment")
  createdAt DateTime @default(now())
}
