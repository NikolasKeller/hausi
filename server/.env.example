# Copy to server/.env for local development. Never commit server/.env.
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET=

# AI-assisted event creation (server-side only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Public origin used in invite links, for example https://example.up.railway.app.
APP_URL=
INVITE_CODE=

# Optional integrations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
