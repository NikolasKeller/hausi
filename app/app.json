{
  "expo": {
    "name": "iykyk",
    "slug": "iykyk",
    "version": "0.1.0",
    "scheme": "iykyk",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0B16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iykyk.app",
      "appleTeamId": "XVLYVZN7Q3"
    },
    "android": {
      "package": "com.iykyk.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#0E0B16",
      "backgroundColor": "#0E0B16"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "iykyk needs access to your photos so you can set an event cover."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iykyk uses your location to find parties happening near you."
        }
      ]
    ]
  }
}
