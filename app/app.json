{
  "expo": {
    "name": "iykyk",
    "slug": "iykyk",
    "version": "0.1.0",
    "scheme": "iykyk",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F1F1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iykyk.app",
      "appleTeamId": "XVLYVZN7Q3"
    },
    "android": {
      "package": "com.iykyk.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#F1F1F1",
      "backgroundColor": "#F1F1F1"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "iykyk needs access to your photos so you can set an event cover."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "iykyk uses your location to find parties happening near you."
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e841cf45-78b3-4826-b161-7eec0c3ba90d"
      }
    },
    "owner": "nikolasgabrielkeller123",
    "updates": {
      "url": "https://u.expo.dev/e841cf45-78b3-4826-b161-7eec0c3ba90d"
    }
  }
}
